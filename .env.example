# Copie para .env ou rode: python scripts/gerar_env.py (gera senhas aleatórias)
POSTGRES_ADMIN_PASSWORD=troque
APP_DB_PASSWORD=troque
DATABASE_URL_ADMIN=postgresql://admin:troque@127.0.0.1:5433/rag
DATABASE_URL=postgresql://app:troque@127.0.0.1:5433/rag
# Chave grátis em console.groq.com. Nunca faça commit dela.
GROQ_API_KEY=
# Etapa 6: sal do hash do IP no log da API (qualquer texto aleatório longo)
SAL_CLIENTE=troque
# Limites da API (opcionais; estes são os padrões)
# LIMITE_POR_MINUTO=5
# LIMITE_POR_DIA=30
# LIMITE_TOTAL_POR_DIA=50
# MCP (/mcp na API). Hosts aceitos além do local, separados por vírgula (na nuvem: o domínio do app)
# MCP_HOSTS=
# Limites do MCP por cliente (opcionais; estes são os padrões)
# MCP_LIMITE_POR_MINUTO=30
# MCP_LIMITE_POR_DIA=500
# MCP_LIMITE_TOTAL_POR_DIA=2000
# Token do cliente MCP para o HTTP (scripts/cliente_mcp.py --url). Crie com: python scripts/token_mcp.py criar <nome>
MCP_TOKEN=
